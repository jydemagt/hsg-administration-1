+    --blue-light:#0f2744;
+    --green:#4ade80;
+    --green-light:#052e16;
+    --red:#f87171;
+    --red-light:#450a0a;
+    --amber:#fbbf24;
+    --amber-light:#451a03;
+  }
+}
+
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg-body);color:var(--text-main);line-height:1.5;-webkit-text-size-adjust:100%}
+
+.top{height:68px;position:fixed;z-index:20;top:0;left:0;right:0;background:var(--bg-topbar);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}
+.brand{display:flex;gap:10px;align-items:center;color:var(--text-heading);text-decoration:none;min-height:var(--touch-min)}
+.brandmark{font-size:26px}
+.brand strong,.brand small{display:block}
+.brand small{font-size:11px;color:var(--text-muted);font-weight:500}
+.top-actions{display:flex;align-items:center;gap:12px}
+.catalog-top{background:var(--blue);color:#fff;text-decoration:none;padding:9px 14px;border-radius:var(--radius-md);font-weight:700;display:inline-flex;align-items:center;min-height:var(--touch-min)}
+
+.sidebar{position:fixed;top:68px;left:0;bottom:0;width:230px;background:var(--bg-sidebar);border-right:1px solid var(--line);padding:18px 12px;z-index:10;overflow-y:auto}
+.sidebar nav{display:flex;flex-direction:column;gap:4px}
+.nav-section-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);padding:12px 12px 4px 12px;margin-top:6px}
+.sidebar a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--radius-md);color:var(--text-main);text-decoration:none;font-weight:650;font-size:14px;min-height:var(--touch-min)}
+.sidebar a.active,.sidebar a:hover{background:var(--blue-light);color:var(--blue)}
+
+.content{margin-left:230px;padding:92px 24px 70px;max-width:1500px}
+.page-title{display:flex;align-items:center;justify-space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px}
+.page-title h1{font-size:25px;margin:0;color:var(--text-heading)}
+
+.card{background:var(--bg-card);border:1px solid var(--line);border-radius:var(--radius-lg);padding:18px;margin-bottom:16px;box-shadow:var(--shadow-sm)}
+.narrow{max-width:620px;margin:60px auto}
+.public{padding:30px}
+.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
+.metric strong{display:block;font-size:28px;color:var(--text-heading)}
+.metric span{color:var(--text-muted);font-size:13px}
+.split{display:grid;grid-template-columns:1fr 1fr;gap:16px}
+.three{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
+.four{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
+
+.table-wrap{overflow:auto;background:var(--bg-card);border:1px solid var(--line);border-radius:var(--radius-lg)}
+table{border-collapse:collapse;width:100%;min-width:720px}
+th,td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--line);font-size:14px;color:var(--text-main)}
+th{background:var(--bg-body);color:var(--text-muted);white-space:nowrap;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700}
+tr:last-child td{border-bottom:0}
+
+label{display:block;font-size:13px;font-weight:700;color:var(--text-main);margin:10px 0}
+input,select,textarea{display:block;width:100%;padding:10px 12px;margin-top:6px;border:1px solid var(--line-strong);border-radius:var(--radius-md);background:var(--bg-card);color:var(--text-main);font:inherit;min-height:var(--touch-min)}
+textarea{min-height:110px;resize:vertical}
+
+button,.button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:var(--radius-md);padding:10px 16px;background:var(--blue);color:#fff;text-decoration:none;font-weight:750;cursor:pointer;font:inherit;min-height:var(--touch-min);touch-action:manipulation}
+.button.secondary,button.secondary{background:var(--bg-card);color:var(--text-main);border:1px solid var(--line-strong)}
+.button.danger,button.danger{background:var(--red);color:#fff}
+.button.success,button.success{background:var(--green);color:#fff}
+.button.small,button.small{padding:6px 10px;min-height:36px;font-size:12px}
+button:disabled,.button:disabled,input[type="submit"]:disabled{opacity:0.65;cursor:not-allowed;pointer-events:none}
+
+.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
+.inline{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
+.inline>label{min-width:170px;flex:1}
+
+.flash{padding:12px 14px;border-radius:var(--radius-md);margin-bottom:14px;border:1px solid transparent;font-weight:600}
+.flash.success{background:var(--green-light);color:var(--green);border-color:var(--green)}
+.flash.error,.flash.danger{background:var(--red-light);color:var(--red);border-color:var(--red)}
+.flash.warning{background:var(--amber-light);color:var(--amber);border-color:var(--amber)}
+
+.badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:var(--radius-pill);background:var(--bg-body);color:var(--text-muted);font-size:12px;font-weight:700}
+.badge.green{background:var(--green-light);color:var(--green)}
+.badge.red{background:var(--red-light);color:var(--red)}
+.badge.blue{background:var(--blue-light);color:var(--blue)}
+.badge.amber{background:var(--amber-light);color:var(--amber)}
+
+.muted{color:var(--text-muted);font-size:13px}
+
+/* Command Palette & Search */
+.global-search-wrap{position:relative;flex:1;max-width:380px;margin:0 16px}
+.global-search-wrap input{margin:0;padding:8px 14px;font-size:13px;border-radius:var(--radius-pill);background:var(--bg-body);border:1px solid var(--line-strong)}
+.global-search-dropdown{position:absolute;top:100%;left:0;right:0;margin-top:6px;background:var(--bg-card);border:1px solid var(--line-strong);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);max-height:380px;overflow-y:auto;z-index:500}
+.global-search-item{display:block;padding:10px 14px;border-bottom:1px solid var(--line);text-decoration:none;color:var(--text-main);font-size:13px;min-height:var(--touch-min)}
+.global-search-item:hover,.global-search-item.active{background:var(--blue-light);color:var(--blue);outline:0}
+.global-search-item strong{display:block;font-size:13px}
+.global-search-item small{display:block;color:var(--text-muted);font-size:11px}
+
+.searchbar{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center}
+.searchbar input,.searchbar select{margin:0}
+.searchbar input{flex:1;min-width:200px}
+
+/* Theme Toggle Button */
+.theme-toggle{background:transparent;border:1px solid var(--line-strong);color:var(--text-main);padding:6px 10px;border-radius:var(--radius-md);cursor:pointer;font-size:16px;min-height:var(--touch-min);display:inline-flex;align-items:center;justify-content:center}
+
+/* Accessibility Skip Link */
+.skip-link{position:absolute;top:-100px;left:10px;z-index:9999;padding:10px 16px;background:var(--blue);color:#fff;font-weight:700;border-radius:var(--radius-md);text-decoration:none;transition:top .15s ease}
+.skip-link:focus{top:10px;outline:3px solid var(--amber)}
+
+/* Mobile Navigation */
+.mobile-nav{display:none}
+
+/* Breakpoint 1024px+ (Desktop) */
+@media(min-width:1024px){
+  .sidebar{display:block}
+}
+
+/* Breakpoint 768px–1023px (Tablet) */
+@media(max-width:1023px){
+  .sidebar{display:none}
+  .content{margin-left:0;padding:84px 16px 88px}
+  .top{padding:0 16px}
+  .grid{grid-template-columns:repeat(2,1fr)}
+  .split,.three,.four{grid-template-columns:1fr}
+}
+
+/* Breakpoints Mobile: 430px, 390px, 375px, 320px */
+@media(max-width:767px){
+  .top{height:62px;padding:0 12px}
+  .content{margin-left:0;padding:78px 12px 84px}
+  .grid{grid-template-columns:1fr 1fr}
+  .split,.three,.four{grid-template-columns:1fr}
+  .desktop-only{display:none!important}
+
+  .searchbar{display:flex;flex-direction:column;align-items:stretch;gap:10px}
+  .searchbar input,.searchbar select,.searchbar button{width:100%!important;min-width:0}
+
+  .mobile-nav{position:fixed;z-index:30;left:0;right:0;bottom:0;height:68px;padding-bottom:env(safe-area-inset-bottom);background:var(--bg-topbar);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr)}
+  .mobile-nav a{display:flex;flex-direction:column;align-items:center;justify-content:center;text-decoration:none;color:var(--text-muted);font-size:18px;gap:2px;min-height:var(--touch-min)}
+  .mobile-nav a.active,.mobile-nav a[aria-current="page"]{color:var(--blue)}
+  .mobile-nav span{font-size:10px;font-weight:700}
+
+  .mobile-product{background:var(--bg-card);border:1px solid var(--line);border-radius:var(--radius-lg);padding:14px;margin-bottom:10px;box-shadow:var(--shadow-sm)}
+  .mobile-product-main{display:grid;grid-template-columns:56px 1fr;gap:12px;align-items:start}
+  .mobile-product img{width:52px;height:82px;object-fit:contain}
+  .mobile-product h3{font-size:15px;margin:0 0 4px;color:var(--text-heading)}
+  .mobile-product .sku{font-size:12px;color:var(--text-muted)}
+  .mobile-stock-line{display:grid;grid-template-columns:1fr auto;font-size:13px;padding:3px 0}
+  .mobile-stock-line.total{margin-top:6px;padding-top:6px;border-top:1px solid var(--line);font-weight:800}
+
+  footer{display:none}
+}
+
+@media(max-width:390px){
+  .grid{grid-template-columns:1fr}
+  .metric strong{font-size:24px}
+  .card{padding:14px}
+}

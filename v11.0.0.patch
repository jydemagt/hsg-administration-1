-/* Accessibility & Skip link */
-.skip-link{position:absolute;top:-100px;left:10px;z-index:9999;padding:10px 16px;background:#155eef;color:#fff;font-weight:700;border-radius:8px;text-decoration:none;transition:top .15s ease}
-.skip-link:focus{top:10px;outline:3px solid #fffaeb}
+.hsg-modal[hidden]{display:none}
+.hsg-modal{position:fixed;inset:0;z-index:1200;display:grid;place-items:center;padding:16px}
+.hsg-modal-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.75);backdrop-filter:blur(3px)}
+.hsg-modal-dialog{position:relative;z-index:1;width:min(720px,calc(100vw - 24px));max-height:calc(100vh - 24px);overflow:auto;background:var(--bg-card);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:20px;border:1px solid var(--line)}
+.hsg-modal-close{position:absolute;top:10px;right:10px;width:40px;height:40px;padding:0;border:1px solid var(--line-strong);border-radius:50%;background:var(--bg-card);color:var(--text-main);font-size:24px;z-index:3;cursor:pointer;display:grid;place-items:center}
+
+@media(max-width:700px){
+  .hsg-modal{padding:0;align-items:end}
+  .hsg-modal-dialog{width:100%;max-height:92dvh;border-radius:20px 20px 0 0;padding:20px 16px calc(20px + env(safe-area-inset-bottom))}
+}
+
+/* Image Lightbox */
+.image-preview-button{display:inline-flex;align-items:center;justify-content:center;width:76px;height:94px;padding:4px;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--bg-card);cursor:zoom-in;transition:border-color .15s,box-shadow .15s,transform .15s}
+.image-preview-button:hover,.image-preview-button:focus-visible{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-light);outline:0}
+.image-preview-button .image-preview{display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
+
+footer{text-align:center;color:var(--text-muted);font-size:12px;padding:24px;margin-left:230px}
